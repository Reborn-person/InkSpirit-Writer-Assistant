// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserLevel {
  PRO
  PRO_PLUS
  MAX
  PROMAX
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  level     UserLevel @default(PRO)
  membershipExpiresAt DateTime?
  tokenVersion Int @default(1)
  createdAt DateTime @default(now())

  invitationCode InvitationCode?
  backups        ProjectBackup[]
  marketPrompts  MarketPrompt[]
  marketCards    MarketCard[]
  marketIdeas    MarketIdea[]
  settings       UserSettings?
  novels         Novel[]
  quota          UserQuota?
}

model UserQuota {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  dailyTokensUsed Int      @default(0)
  dailyTokenLimit Int      @default(100000) // Default limit for PRO users
  totalTokensUsed Int      @default(0)
  lastResetDate   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model InvitationCode {
  id        String   @id @default(uuid())
  code      String   @unique
  isUsed    Boolean  @default(false)
  usedBy    User?    @relation(fields: [usedById], references: [id])
  usedById  String?  @unique
  createdAt DateTime @default(now())
}

model ProjectBackup {
  id        String   @id @default(uuid())
  data      String   // JSON string of the backup
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model MarketPrompt {
  id           String   @id @default(uuid())
  title        String
  content      String
  categoryId   String
  uploaderName String
  uploaderId   String?
  uploader     User?    @relation(fields: [uploaderId], references: [id])
  likeCount    Int      @default(0)
  createdAt    DateTime @default(now())
  lastModified DateTime @updatedAt
}

model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  dataEnc   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketCard {
  id           String   @id @default(uuid())
  title        String
  type         String
  example      String?
  analysis     String?
  tags         String
  uploaderName String
  uploaderId   String?
  uploader     User?    @relation(fields: [uploaderId], references: [id])
  likeCount    Int      @default(0)
  createdAt    DateTime @default(now())
  lastModified DateTime @updatedAt
}

model MarketIdea {
  id           String   @id @default(uuid())
  title        String
  hook         String
  summary      String
  tags         String
  uploaderName String
  uploaderId   String?
  uploader     User?    @relation(fields: [uploaderId], references: [id])
  likeCount    Int      @default(0)
  createdAt    DateTime @default(now())
  lastModified DateTime @updatedAt
}

// New Models for Chapter Persistence
model Novel {
  id        String    @id // Allow client-side ID or UUID
  title     String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapters  Chapter[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Chapter {
  id        String   @id // Allow client-side ID or UUID
  title     String
  content   String   // Content storage
  summary   String?
  novelId   String
  novel     Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  order     Int      @default(0)
  status    String   @default("draft") 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
